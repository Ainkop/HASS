esphome:
  name: esp32-epaper-receiver
  friendly_name: ESP32 Sauna vastuvotja

esp32:
  board: esp32dev
  framework:
    type: esp-idf

logger:

api:

ota:
  - platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  power_save_mode: NONE
  ap:
    ssid: "ESP32 Receiver Fallback"
    password: "1ft1tR5H0ds7"

captive_portal:

# ESP-NOW raadio
espnow:
  peers:
    - E0:8C:FE:2F:B8:64   # saatja MAC

# Andmete vastuvõtt saatjalt
packet_transport:
  - platform: espnow
    id: espnow_transport
    providers:
      - name: esp32-ds18b20-pt100   # peab võrduma saatja esphome: name

sensor:
  - platform: packet_transport
    id: rc_pt100_sensor
    provider: esp32-ds18b20-pt100
    remote_id: pt100_sensor
    internal: false
    name: "Sauna (PT100)"
    unit_of_measurement: "°C"
    accuracy_decimals: 1

  - platform: packet_transport
    id: rc_boiler_sensor
    provider: esp32-ds18b20-pt100
    remote_id: boiler_sensor
    internal: false
    name: "Boiler (DS18B20)"
    unit_of_measurement: "°C"
    accuracy_decimals: 1

# SPI TFT ekraanile
spi:
  clk_pin: GPIO18
  mosi_pin: GPIO23
  miso_pin: GPIO19

font:
  - file: "gfonts://Roboto"
    id: font_medium
    size: 22
  - file: "gfonts://Roboto"
    id: font_large
    size: 56

# TFT ekraan (TFT_eSPI vaikepin-id ESP32 jaoks)
display:
  - platform: ili9xxx
    id: my_display
    model: ILI9341
    cs_pin: GPIO15
    dc_pin: GPIO2
    reset_pin: GPIO4
    rotation: 90
    update_interval: 2s
    lambda: |-
      it.fill(Color(255, 255, 255));
      it.line(160, 50, 160, 220, Color::BLACK);

      it.print(160, 8, id(font_medium), Color::BLACK, TextAlign::TOP_CENTER, "TEMPERATUUR");

      // Vasak: PT100 (sauna)
      it.print(80, 60, id(font_medium), Color::BLACK, TextAlign::TOP_CENTER, "PT100");
      if (id(rc_pt100_sensor).has_state() && !isnan(id(rc_pt100_sensor).state)) {
        it.printf(80, 110, id(font_large), Color::BLACK, TextAlign::CENTER, "%.1f", id(rc_pt100_sensor).state);
      } else {
        it.print(80, 110, id(font_large), Color::BLACK, TextAlign::CENTER, "--");
      }
      it.print(80, 165, id(font_medium), Color::BLACK, TextAlign::TOP_CENTER, "°C");

      // Parem: DS18B20 (boiler)
      it.print(240, 60, id(font_medium), Color::BLACK, TextAlign::TOP_CENTER, "DS18B20");
      if (id(rc_boiler_sensor).has_state() && !isnan(id(rc_boiler_sensor).state)) {
        it.printf(240, 110, id(font_large), Color::BLACK, TextAlign::CENTER, "%.1f", id(rc_boiler_sensor).state);
      } else {
        it.print(240, 110, id(font_large), Color::BLACK, TextAlign::CENTER, "--");
      }
      it.print(240, 165, id(font_medium), Color::BLACK, TextAlign::TOP_CENTER, "°C");
