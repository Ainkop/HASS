# claude 26.10.26

esphome:
  name: sauna-saatja

esp32:
  board: esp32dev
  framework:
    type: esp-idf

logger:

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

api:

ota:
  platform: esphome

spi:
  clk_pin: GPIO18
  mosi_pin: GPIO23
  miso_pin: GPIO19

one_wire:
  - platform: gpio
    pin: GPIO4

sensor:
  - platform: max31865
    name: "Sauna temperatuur"
    id: sauna_temp
    cs_pin: GPIO5
    reference_resistance: 430 Ω
    rtd_nominal_resistance: 100 Ω
    rtd_wires: 3
    mains_filter: 50 Hz
    update_interval: 2s
    unit_of_measurement: "°C"
    accuracy_decimals: 1

  - platform: dallas_temp
    name: "Vee temperatuur"
    id: vee_temp
    update_interval: 2s
