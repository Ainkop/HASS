esphome:
  name: esp32-ds18b20-pt100
  friendly_name: ESP32 Sauna saatja

esp32:
  board: esp32dev
  framework:
    type: esp-idf

logger:
  level: DEBUG

api:

ota:
  - platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  power_save_mode: NONE
  ap:
    ssid: "Sauna saatja Fallback"
    password: "1ft1tR5H0ds7"

captive_portal:

# ESP-NOW raadio
espnow:

# Andurite edastus vastuvõtjale
packet_transport:
  - platform: espnow
    id: espnow_transport
    sensors:
      - pt100_sensor
      - boiler_sensor

# MAX31865 SPI
spi:
  clk_pin: GPIO18
  mosi_pin: GPIO23
  miso_pin: GPIO19

# DS18B20 1-Wire
one_wire:
  - platform: gpio
    id: one_wire_bus
    pin: GPIO4

sensor:
  # Sauna temperatuur (PT100)
  - platform: max31865
    id: pt100_sensor
    name: "Sauna temperatuur"
    cs_pin: GPIO5
    reference_resistance: 430 Ω
    rtd_nominal_resistance: 100 Ω
    rtd_wires: 3
    mains_filter: 50 Hz
    update_interval: 2s
    unit_of_measurement: "°C"
    accuracy_decimals: 1

  # Boileri temperatuur (DS18B20)
  - platform: dallas_temp
    id: boiler_sensor
    one_wire_id: one_wire_bus
    name: "Boiler temperatuur"
    update_interval: 2s
    unit_of_measurement: "°C"
    accuracy_decimals: 1
