esphome:
  name: esp32-ds18b20-pt100
  friendly_name: ESP32 DS18B20 PT100

esp32:
  board: esp32dev
  variant: esp32
  framework:
    type: esp-idf

logger:
  level: DEBUG

api:

ota:
  - platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  power_save_mode: NONE
  ap:
    ssid: ESP32 dev Mod+ Fallback Hotspot
    password: "1ft1tR5H0ds7"

captive_portal:

# 1. Käivitame ESP-NOW raadio
espnow:

# 2. Tarkvaraline SPI siin MAX31865 jaoks, et vältida häireid
software_spi:
  id: sw_spi
  clk_pin: GPIO18
  mosi_pin: GPIO23
  miso_pin: GPIO19

# 3. PARANDATUD: Viidud tagasi puhtale standardsele kujule, täpselt nagu sinu vanas koodis
one_wire:
  - platform: gpio
    id: one_wire_bus
    pin: GPIO4                        # PARANDATUD: Eemaldatud open_drain, mis liini maha tõmbas

# 4. Defineerime andurid
sensor:
  # ---- PT100 andur ----
  - platform: max31865
    id: pt100_sensor
    name: "PT100 Temperatuur"
    spi_id: sw_spi
    cs_pin: GPIO5
    reference_resistance: 430.0
    rtd_nominal_resistance: 100.0
    rtd_wires: 3
    update_interval: 2s
    on_value:
      - then:
          - script.execute: send_now_script

  # ---- DS18B20 (Boiler) andur ----
  - platform: dallas_temp
    id: boiler_sensor
    one_wire_id: one_wire_bus
    address: 0xe73c01f0951e0e28
    name: "Boiler Temperatuur"
    update_interval: 2s

# 5. Saatmisskript (pakib andmed 8-ks baidiks, et ühilduda vastuvõtjaga)
script:
  - id: send_now_script
    mode: single
    then:
      - lambda: |-
          if (id(pt100_sensor).has_state() && id(boiler_sensor).has_state()) {
            
            struct __attribute__((packed)) {
              int pt100;
              float ds18b20;
            } myData;

            myData.pt100 = (int)id(pt100_sensor).state;
            myData.ds18b20 = id(boiler_sensor).state;

            uint8_t receiverAddress[] = {0x58, 0xBF, 0x25, 0x33, 0x58, 0xE8};
            esp_now_send(receiverAddress, (uint8_t *) &myData, sizeof(myData));
            
            ESP_LOGD("custom_espnow", "Saadetud üle YAML-i | PT100: %d C | DS18B20: %.2f C", myData.pt100, myData.ds18b20);
          }
