esphome:
  name: esp32-epaper-receiver
  friendly_name: ESP32 E-Paper Receiver

esp32:
  board: esp32dev
  framework:
    type: esp-idf

logger:

api:

ota:
  - platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  power_save_mode: NONE
  ap:
    ssid: "ESP32 E-Paper Fallback"
    password: "1ft1tR5H0ds7"

captive_portal:

# ESP-NOW raadio
espnow:
  peers:
    - E0:8C:FE:2F:B8:64   # saatja MAC

# Andmete vastuvõtt saatjalt
packet_transport:
  - platform: espnow
    id: espnow_transport
    providers:
      - name: esp32-ds18b20-pt100   # peab võrduma saatja esphome: name

sensor:
  - platform: packet_transport
    id: rc_pt100_sensor
    provider: esp32-ds18b20-pt100
    remote_id: pt100_sensor
    name: "Sauna (PT100)"
    unit_of_measurement: "°C"
    accuracy_decimals: 1

  - platform: packet_transport
    id: rc_boiler_sensor
    provider: esp32-ds18b20-pt100
    remote_id: boiler_sensor
    name: "Boiler (DS18B20)"
    unit_of_measurement: "°C"
    accuracy_decimals: 1

# SPI e-paper ekraanile
spi:
  clk_pin: GPIO18
  mosi_pin: GPIO23

font:
  - file: "gfonts://Roboto"
    id: font_small
    size: 12
  - file: "gfonts://Roboto"
    id: font_medium
    size: 20
  - file: "gfonts://Roboto"
    id: font_large
    size: 32

# Waveshare 2.13" e-paper
display:
  - platform: waveshare_epaper
    id: my_display
    model: 2.13in-ttgo-b74
    cs_pin: GPIO5
    dc_pin: GPIO17
    reset_pin: GPIO16
    busy_pin: GPIO4
    rotation: 90°
    full_update_every: 1
    update_interval: 60s
    lambda: |-
      it.print(10, 0, id(font_small), "ESP-NOW MONITOR");

      it.print(10, 22, id(font_medium), "SAUNA:");
      if (id(rc_pt100_sensor).has_state() && !isnan(id(rc_pt100_sensor).state)) {
        it.printf(110, 14, id(font_large), "%.1f °C", id(rc_pt100_sensor).state);
      } else {
        it.print(110, 14, id(font_large), "-- °C");
      }

      it.print(10, 72, id(font_medium), "BOILER:");
      if (id(rc_boiler_sensor).has_state() && !isnan(id(rc_boiler_sensor).state)) {
        it.printf(110, 64, id(font_large), "%.1f °C", id(rc_boiler_sensor).state);
      } else {
        it.print(110, 64, id(font_large), "-- °C");
      }
